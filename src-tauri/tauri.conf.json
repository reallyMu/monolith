        "description": "Kotlin",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "c",
          "h"
        ],
        "name": "C Source",
        "description": "C",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "cpp",
          "cc",
          "cxx",
          "hpp"
        ],
        "name": "C++ Source",
        "description": "C++",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [

        ],
        "name": "Shell Script",
        "description": "Shell",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "dockerfile"
        ],
        "name": "Dockerfile",
        "description": "Dockerfile",
        "role": "Editor",
        "rank": "Default"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}

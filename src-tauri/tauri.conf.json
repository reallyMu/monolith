        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "php"
        ],
        "name": "PHP Source",
        "description": "PHP",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "swift"
        ],
        "name": "Swift Source",
        "description": "Swift",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "r"
        ],

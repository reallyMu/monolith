{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monolith",
  "version": "0.2.0",
  "identifier": "com.muqiang.monolith",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Monolith",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "../third-party/downmark/run": "third-party/downmark/run",
      "../third-party/downmark/downmark": "third-party/downmark/downmark",
      "../third-party/downmark/README.md": "third-party/downmark/README.md",
      "resources/clipper-extension": "clipper-extension",
      "../skills/monolith-assets": "skills/monolith-assets"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "Markdown",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/markdown",
        "contentTypes": [
          "net.daringfireball.markdown"
        ]
      },
      {
        "ext": [
          "txt",
          "text",
          "log"
        ],
        "name": "Plain Text",
        "description": "Plain text",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/plain",
        "contentTypes": [
          "public.plain-text"
        ]
      },
      {
        "ext": [
          "json",
          "jsonc"
        ],
        "name": "JSON Document",
        "description": "JSON",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "application/json",
        "contentTypes": [
          "public.json"
        ]
      },
      {
        "ext": [
          "xml"
        ],
        "name": "XML Document",
        "description": "XML",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "application/xml",
        "contentTypes": [
          "public.xml"
        ]
      },
      {
        "ext": [
          "svg"
        ],
        "name": "SVG Document",
        "description": "SVG",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "image/svg+xml",
        "contentTypes": [
          "public.svg-image"
        ]
      },
      {
        "ext": [
          "plist"
        ],
        "name": "Property List",
        "description": "Apple property list",
        "role": "Editor",
        "rank": "Default",
        "contentTypes": [
          "com.apple.property-list"
        ]
      },
      {
        "ext": [
          "html",
          "htm",
          "xhtml"
        ],
        "name": "HTML Document",
        "description": "HTML",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/html",
        "contentTypes": [
          "public.html"
        ]
      },
      {
        "ext": [
          "css",
          "scss",
          "less"
        ],
        "name": "Stylesheet",
        "description": "CSS / SCSS / Less",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "yml",
          "yaml"
        ],
        "name": "YAML Document",
        "description": "YAML",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "toml",
          "ini",
          "env",
          "conf",
          "properties"
        ],
        "name": "Config File",
        "description": "INI-like config",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "csv",
          "tsv"
        ],
        "name": "Tabular Text",
        "description": "CSV / TSV",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "graphql",
